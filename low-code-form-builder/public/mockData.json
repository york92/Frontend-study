            ] },
            { "id": "n13", "type": "number", "props": { "label": "借款金额（元）", "field": "loanAmount", "placeholder": "请输入金额", "min": 0, "required": true, "readonly": false, "width": 12, "visibleWhen": { "field": "needLoan", "value": "true" } } }
          ] }
        ]
      }
