            ] },
            { "id": "n8", "type": "radio", "props": { "label": "出行方式", "field": "transport", "options": ["飞机", "高铁", "自驾"], "defaultValue": "飞机", "required": false, "readonly": false, "width": 12, "visibleWhen": null } },
            { "id": "n9", "type": "textarea", "props": { "label": "出差事由", "field": "reason", "placeholder": "请简要说明出差目的", "required": true, "readonly": false, "rules": "", "width": 12, "visibleWhen": null } },
